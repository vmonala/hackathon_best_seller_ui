# Data source: "mock" (bundled fixtures) or "live" (FastAPI)
VITE_API_MODE=mock

# Per-module overrides. Marketplace segments and AI discovery are served by the
# Segment Intelligence API; Data Seller Insights has no endpoints yet, so it
# falls back to VITE_API_MODE above.
VITE_API_MODE_SEGMENTS=live
VITE_API_MODE_DISCOVERY=live
VITE_API_MODE_SELLER=mock

# Base URL used when a module is live. "/api/v1" routes through the Vite dev
# proxy, which strips /api and forwards to VITE_FASTAPI_ORIGIN (see
# vite.config.ts). Use a full origin like http://localhost:8000/v1 to call
# FastAPI directly, which needs CORS enabled on the backend.
VITE_API_BASE_URL=/api/v1

# Origin the dev proxy forwards /api to. Only used by vite.config.ts.
VITE_FASTAPI_ORIGIN=http://localhost:8000

# Simulated network latency for mock mode, in milliseconds.
VITE_MOCK_LATENCY_MS=250
